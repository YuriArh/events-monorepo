generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum UserRole {
  USER
  ADMIN
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model User {
  id              String    @id @default(cuid())
  /// Always lowercase, trimmed. The service normalizes this.
  email           String    @unique
  /// argon2id hash. Never included in API responses.
  passwordHash    String
  name            String?
  /// Filename in uploads, not a URL (same as Event.imageKey).
  imageKey        String?
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  authTokens      AuthToken[]
  /// Events this user organizes.
  organizedEvents Event[]
}

/// Server session. The cookie stores the raw token; this table stores only its sha256.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One-shot tokens for password reset and email verification.
model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// ───────── Events and addresses ─────────

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// Filename within the API's uploads directory, not a URL.
  imageKey    String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Unique: at most one event may point at a given address (1:1).
  addressId String?  @unique
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  /// Organizer. Nullable for events created before ownership existed;
  /// deleting the user leaves the event (onDelete: SetNull).
  organizerId String?
  organizer   User?   @relation(fields: [organizerId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([organizerId])
}

model Address {
  id         String  @id @default(cuid())
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String

  // Populated from the Photon result that produced this address. Null for
  // addresses created before geocoding existed.
  lat   Float?
  lon   Float?
  osmId String?
  raw   Json?

  event Event?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}

