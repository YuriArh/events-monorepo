generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          String    @id @default(cuid())
  name        String
  description String?
  /// Filename within the API's uploads directory, not a URL.
  imageKey    String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Unique: at most one event may point at a given address (1:1).
  addressId String?  @unique
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@index([startsAt])
}

/// Optional 1:1 with Event. The foreign key lives on Event (`addressId`), not
/// here — so an address can exist before it is linked, and deleting it only
/// nulls that event's `addressId` (onDelete: SetNull).
model Address {
  id         String  @id @default(cuid())
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String

  event Event?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}
